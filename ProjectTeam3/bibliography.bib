@article{Luo2025,
doi = {10.1088/1742-6596/3042/1/012004},
url = {https://doi.org/10.1088/1742-6596/3042/1/012004},
year = {2025},
month = {June},
publisher = {IOP Publishing},
volume = {3042},
number = {1},
pages = {012004},
author = {Luo, Jie and Zhou, Yicheng},
title = {Dyck paths and Catalan numbers},
journal = {Journal of Physics: Conference Series},
abstract = {This paper explores the combinatorial properties of Dyck paths and their relationship with Catalan numbers, a fundamental sequence in mathematics with wide-ranging applications. The study introduces a specialized class of Dyck paths, termed k-Dyck paths, and further generalizes them into (q, t)-Dyck paths. The generating functions for these paths are derived, demonstrating their close relationship with Catalan numbers. Additionally, the paper presents novel methods for calculating the number of these paths, including a detailed analysis of expanded Dyck paths and lattice paths. The findings reveal elegant and simplified generating functions for (k, k+1)-Dyck paths and extend the discussion to applications in random walks and other path-related problems. This work contributes new insights into combinatorial path enumeration and provides tools for addressing complex path counting challenges.}
}

