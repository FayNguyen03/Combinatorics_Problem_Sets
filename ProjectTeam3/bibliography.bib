@article{Bona2019,
title = {Pattern avoidance in permutations and their squares},
journal = {Discrete Mathematics},
volume = {342},
number = {11},
pages = {3194-3200},
year = {2019},
issn = {0012-365X},
doi = {https://doi.org/10.1016/j.disc.2019.06.029},
url = {https://www.sciencedirect.com/science/article/pii/S0012365X19302250},
author = {Miklós Bóna and Rebecca Smith},
keywords = {Cycles, Permutation pattern, Permutation square},
abstract = {We study permutations p such that both p and p2 avoid a given pattern q. We obtain a generating function for the case of q=312 (equivalently, q=231), we prove that if q is monotone increasing, then above a certain length, there are no such permutations, and we prove an upper bound for q=321. We also present some intriguing questions in the case of q=132.}
}

